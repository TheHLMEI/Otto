/* ----------------- CNV_MOCK1 ----------------- */

insert_job:      CNV_MOCK1
job_type:        b
description:     "Runs the CNV_MOCK1"

 /* ----------------- CNV_PRELOAD ----------------- */

 insert_job:      CNV_PRELOAD
 job_type:        b
 box_name:        CNV_MOCK1
 description:     "The CNV_PRELOAD BOX"

  /* ----------------- CNV_DROPFKEY_PDP ----------------- */

  insert_job:      CNV_DROPFKEY_PDP
  job_type:        c
  box_name:        CNV_PRELOAD
  command:         cnv_ottojob.sh run_ddl.sh -F TGT -d Plandata_Parallel -s dbo -q DROP_FKEY
  description:     "Drop FK's on the PDP DB"

  /* ----------------- CNV_DROPINDEX_PDP ----------------- */

  insert_job:      CNV_DROPINDEX_PDP
  job_type:        c
  box_name:        CNV_PRELOAD
  command:         cnv_ottojob.sh run_ddl.sh -F TGT -d Plandata_Parallel -s dbo -q DROP_INDEX
  description:     "Drop Indexes on the PDP DB"

 /* ----------------- CNV_UNLOAD ----------------- */

 insert_job:      CNV_UNLOAD
 job_type:        b
 box_name:        CNV_MOCK1
 condition:       s(CNV_PRELOAD)
 description:     "The CNV_UNLOAD BOX"

  /* ----------------- CNV_SYS_MEMO_S ----------------- */

  insert_job:      CNV_SYS_MEMO_S
  job_type:        c
  box_name:        CNV_UNLOAD
  command:         cnv_ottojob.sh cnvs
  description:     "Run the PRV_MAIN unload"

  /* ----------------- CNV_SYS_ENTITY_S ----------------- */

  insert_job:      CNV_SYS_ENTITY_S
  job_type:        c
  box_name:        CNV_UNLOAD
  command:         cnv_ottojob.sh cnvs
  description:     "Run the PRV_MAIN unload"

  /* ----------------- CNV_PRV_MAIN_S ----------------- */

  insert_job:      CNV_PRV_MAIN_S
  job_type:        c
  box_name:        CNV_UNLOAD
  command:         cnv_ottojob.sh cnvs
  description:     "Run the PRV_MAIN unload"

  /* ----------------- CNV_PRV_AFFILIATIONS_S ----------------- */

  insert_job:      CNV_PRV_AFFILIATIONS_S
  job_type:        c
  box_name:        CNV_UNLOAD
  command:         cnv_ottojob.sh cnvs
  description:     "Unload the Claims to the driver file"

  /* ----------------- CNV_MBR_MAIN_S ----------------- */

  insert_job:      CNV_MBR_MAIN_S
  job_type:        c
  box_name:        CNV_UNLOAD
  command:         cnv_ottojob.sh cnvs
  description:     "Unload the Claims to the driver file"

  /* ----------------- CNV_MBR_ENROLLMENTS_S ----------------- */

  insert_job:      CNV_MBR_ENROLLMENTS_S
  job_type:        c
  box_name:        CNV_UNLOAD
  command:         cnv_ottojob.sh cnvs
  description:     "Run the MBR_MAIN unload"

  /* ----------------- CNV_CLM_MAIN_S ----------------- */

  insert_job:      CNV_CLM_MAIN_S
  job_type:        c
  box_name:        CNV_UNLOAD
  command:         cnv_ottojob.sh cnvs
  condition:       s(CNV_PRV_MAIN_S) & s(CNV_PRV_AFFILIATIONS_S) & s(CNV_MBR_MAIN_S) & s(CNV_MBR_ENROLLMENTS_S) & s(CNV_SYS_ENTITY_S) & s(CNV_SYS_MEMO_S)
  description:     "Unload the Claims to the driver file"

 /* ----------------- CNV_CONVERT ----------------- */

 insert_job:      CNV_CONVERT
 job_type:        b
 box_name:        CNV_MOCK1
 description:     "The CNV_CONVERT BOX"

  /* ----------------- CNV_SYS_MEMO ----------------- */

  insert_job:      CNV_SYS_MEMO
  job_type:        b
  box_name:        CNV_CONVERT
  condition:       s(CNV_SYS_MEMO_S)
  description:     "The PRV_MAIN BOX"

   /* ----------------- CNV_SYS_MEMO_J ----------------- */

   insert_job:      CNV_SYS_MEMO_J
   job_type:        c
   box_name:        CNV_SYS_MEMO
   command:         cnv_ottojob.sh cnvj --runid $RUNID
   description:     "Run the PRV_MAIN conversion job"

   /* ----------------- CNV_SYS_MEMO_O_PDP ----------------- */

   insert_job:      CNV_SYS_MEMO_O_PDP
   job_type:        c
   box_name:        CNV_SYS_MEMO
